  shorttitle = {Heavy Rains and Hydrogeological Disasters on {{February}} 18th–19th, 2023, in the City of {{São Sebastião}}, {{São Paulo}}, {{Brazil}}},
  author = {Marengo, Jose A. and Cunha, Ana P. and Seluchi, Marcelo E. and Camarinha, Pedro I. and Dolif, Giovanni and Sperling, Vinicius B. and Alcântara, Enner H. and Ramos, Andrea M. and Andrade, Marcio M. and Stabile, Rodrigo A. and Mantovani, José and Park, Edward and Alvala, Regina C. and Moraes, Osvaldo L. and Nobre, Carlos A. and Goncalves, Demerval},
  date = {2024-06},
  journaltitle = {Natural Hazards},

@article{Zhang.2022,
  title = {A {{Vine Copula}}‐{{Based Ensemble Projection}} of {{Precipitation Intensity}}–{{Duration}}–{{Frequency Curves}} at {{Sub}}‐{{Daily}} to {{Multi}}‐{{Day Time Scales}}},
  author = {Zhang, Boen and Wang, Shuo and Moradkhani, Hamid and Slater, Louise and Liu, Jiafeng},
  date = {2022-11},
  journaltitle = {Water Resources Research},
  shortjournal = {Water Resources Research},
  volume = {58},

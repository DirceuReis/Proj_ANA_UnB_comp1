}

@article{Islam.2022,
  title = {Coupling of Satellite-Derived Precipitation Products with {{Bartlett-Lewis}} Model to Estimate Intensity-Frequency-Duration Curves for Remote Areas},
  author = {Islam, Md. Atiqul and Yu, Bofu and Cartwright, Nick},
  date = {2022-06},
  journaltitle = {Journal of Hydrology},
  shortjournal = {Journal of Hydrology},

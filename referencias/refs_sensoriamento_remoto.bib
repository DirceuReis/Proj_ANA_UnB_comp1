@article{Wright.2013,
  title = {Estimating the Frequency of Extreme Rainfall Using Weather Radar and Stochastic Storm Transposition},
  author = {Wright, Daniel B. and Smith, James A. and Villarini, Gabriele and Baeck, Mary Lynn},
  date = {2013-04},
  journaltitle = {Journal of Hydrology},

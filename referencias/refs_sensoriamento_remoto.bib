  author = {Adhikari, Tirtha Raj and Baniya, Binod and Tang, Qiuhong and Chen, Deliang and Talchabhadel, Rocky and Li, He and Shrestha, Suraj and Sigdel, Madan and Budhathoki, Bhumi Raj and Pradhanang, Soni M. and Pradhananga, Dhiraj and Awasthi, Ram Prasad},
  date = {2023-10-02},

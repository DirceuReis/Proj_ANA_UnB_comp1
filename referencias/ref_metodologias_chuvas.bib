@article{simonovicWebbasedToolDevelopment2016,
  title = {A Web-Based Tool for the Development of {{Intensity Duration Frequency}} Curves under Changing Climate},
  author = {Simonovic, Slobodan P. and Schardong, Andre and Sandink, Dan and Srivastav, Roshan},
  date = {2016-07},
  journaltitle = {Environmental Modelling \& Software},
  shortjournal = {Environmental Modelling \& Software},
  volume = {81},
  pages = {136--153},
  issn = {13648152},
  doi = {10.1016/j.envsoft.2016.03.016},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S1364815216300809},
  urldate = {2025-09-17},
  abstract = {Intensity Duration Frequency (IDF) curves are among the most common tools used in water resources management. They are derived from historical rainfall records under the assumption of stationarity. Change of climatic conditions makes the use of historical data for development of IDFs for the future unjustifiable. The IDF\_CC, a web based tool, is designed, developed and implemented to allow local water professionals to quickly develop estimates related to the impact of climate change on IDF curves for almost any local rain monitoring station in Canada. The primary objective of the presented work was to standardize the IDF update process and make the results of current research on climate change impacts on IDF curves accessible to everyone. The tool is developed in the form of a decision support system (DSS) and represents an important step in increasing the capacity of Canadian water professionals to respond to the impacts of climate change.},
  langid = {english},
  file = {C:\Users\bruno\Zotero\storage\P35G6V7A\Simonovic et al. - 2016 - A web-based tool for the development of Intensity Duration Frequency curves under changing climate.pdf}
}
